# Producción: usar el dominio canónico público en build y runtime.
# Desarrollo: reemplazar por http://localhost:3000 y http://localhost:8055.
NEXT_PUBLIC_SITE_URL=https://www.jujuy247.com.ar
NEXT_PUBLIC_DIRECTUS_URL=https://directus-production-244d.up.railway.app

# Entorno explícito de la app: production | staging | development.
# Si se omite, se detecta automáticamente vía VERCEL_ENV (preview -> staging) o NODE_ENV.
NEXT_PUBLIC_APP_ENV=development

# Control de publicación en redes sociales: dry-run | live.
# Fuera de producción toma dry-run por defecto para evitar envíos reales desde staging o local.
SOCIAL_PUBLISH_MODE=dry-run

# Opcional: solo el contenido del meta tag de verificación de Search Console.
GOOGLE_SITE_VERIFICATION=
